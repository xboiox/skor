# Reverse proxy with automatic HTTPS (Let's Encrypt) for SITE_ADDRESS (docs/DEPLOYMENT.md).
# Caddy does not trust incoming X-Forwarded-For by default: it sets the header to the real client IP.
{$SITE_ADDRESS} {
	# Compress pages and API responses — but not the live score stream (text/event-stream).
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy app:3000
}
