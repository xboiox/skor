# Production environment variables for Vercel (docs/DEPLOYMENT.md §B.4).
#
# How to use:
#   1. Copy to a local file that is NOT committed, e.g. .env.vercel (ignored by .gitignore).
#   2. Fill in every value below. Do not reuse values from your development .env.
#   3. Vercel → Project → Settings → Environment Variables → Import .env (or paste),
#      environment: Production.
#
# Never copy the development .env: it points to localhost and uses development secrets.

# --- Database (Neon) ---
# If the Neon database is connected via Vercel → Storage, these two usually exist already:
# just check the values. Pooled host contains "-pooler"; the direct host does not.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- App ---
# Exactly the address users open, with https and without a trailing slash.
APP_URL=https://skor.example.com
GUEST_TTL_DAYS=7

# --- Auth ---
# openssl rand -base64 32
AUTH_SECRET=
# Optional Google sign-in. Redirect URI: https://<domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Client IP (Vercel overwrites X-Forwarded-For with the real client IP) ---
TRUST_PROXY=true
CLIENT_IP_HEADER=x-forwarded-for

# --- Cron (guest cleanup, vercel.json) ---
# openssl rand -hex 24
CRON_SECRET=
