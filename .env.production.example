# Production settings for docker-compose.prod.yml (docs/DEPLOYMENT.md).
# Copy to .env.production on the server and fill in every value. Never commit the real file.

# --- Domain & HTTPS ---
# Public domain pointing (DNS A/AAAA record) to this server. Caddy gets the certificate.
SITE_ADDRESS=skor.example.com
APP_URL=https://skor.example.com

# --- Database (internal to the Docker network) ---
POSTGRES_USER=skor
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=skor

# --- Auth ---
# openssl rand -base64 32
AUTH_SECRET=
# Optional: Google sign-in (redirect URI: https://<domain>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ---
GUEST_TTL_DAYS=7
