# --- Database (docker compose overrides DATABASE_URL for the app container) ---
POSTGRES_USER=skor
POSTGRES_PASSWORD=skor
POSTGRES_DB=skor
DB_PORT=5432
DATABASE_URL=postgres://skor:skor@localhost:5432/skor
TEST_DATABASE_URL=postgres://skor:skor@localhost:5432/skor_test

# --- App ---
APP_URL=http://localhost:3000
GUEST_TTL_DAYS=7

# --- Auth (Fase 5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Client IP / reverse proxy (docs/SECURITY.md) ---
# true ONLY when the app is reached through a proxy that writes CLIENT_IP_HEADER.
# Local development: true, so E2E tests can simulate different clients via X-Forwarded-For.
TRUST_PROXY=false
CLIENT_IP_HEADER=x-forwarded-for
# Comma-separated proxy IPs / IPv4 CIDRs to skip in X-Forwarded-For (empty = take the rightmost)
TRUSTED_PROXIES=
